<CODE>
//高低阈赢益决策
DRAWNUMBER(ISLASTBAR=1,CLOSE,CLOSE,PRECIS2,COLORYELLOW),ALIGN2,FONTSIZE22,VALIGN0;
峰值VA:=IF(ISCONTRACT('螺纹钢')=1,6208,0)+IF(ISCONTRACT('铁矿石')=1,1423,0)+IF(ISCONTRACT('沪铜')=1,89280,0)+IF(ISCONTRACT('沪金')=1,605.98,0)+IF(ISCONTRACT('原油')=1,823.6,0)+IF(ISCONTRACT('豆粕')=1,5086,0)+IF(ISCONTRACT('棕榈油')=1,13808,0)+IF(ISCONTRACT('白糖')=1,7948,0)+IF(ISCONTRACT('PTA')=1,12666,0)+IF(ISCONTRACT('甲醇')=1,4307,0),NODRAW;
谷值VA:=IF(ISCONTRACT('螺纹钢')=1,1567,0)+IF(ISCONTRACT('铁矿石')=1,277.5,0)+IF(ISCONTRACT('沪铜')=1,13610,0)+IF(ISCONTRACT('沪金')=1,175.46,0)+IF(ISCONTRACT('原油')=1,178.6,0)+IF(ISCONTRACT('豆粕')=1,1350,0)+IF(ISCONTRACT('棕榈油')=1,3866,0)+IF(ISCONTRACT('白糖')=1,3832,0)+IF(ISCONTRACT('PTA')=1,3028,0)+IF(ISCONTRACT('甲醇')=1,1419,0),NODRAW;
均值VA:=IF(ISCONTRACT('螺纹钢')=1,3604.16,0)+IF(ISCONTRACT('铁矿石')=1,584.55,0)+IF(ISCONTRACT('沪铜')=1,69218,0)+IF(ISCONTRACT('沪金')=1,330.11,0)+IF(ISCONTRACT('原油')=1,484,0)+IF(ISCONTRACT('豆粕')=1,2923.53,0)+IF(ISCONTRACT('棕榈油')=1,6320.03,0)+IF(ISCONTRACT('白糖')=1,5113.57,0)+IF(ISCONTRACT('PTA')=1,6543.59,0)+IF(ISCONTRACT('甲醇')=1,2471.37,0),NODRAW;
峰值:峰值VA,RGB(180,0,0),NODRAW;
谷值:谷值VA,RGB(0,180,0),NODRAW;
均值:均值VA,RGB(180,180,0),NODRAW;
H0.7M:0.7*峰值+0.3*均值,RGB(210,0,0),NODRAW;
L0.7M:0.7*谷值+0.3*均值,RGB(0,210,0),NODRAW;
H0.5M:0.5*峰值+0.5*均值,RGB(255,0,0),NODRAW;
L0.5M:0.5*谷值+0.5*均值,RGB(0,255,0),NODRAW;
HH1:=IFELSE(HIGH<REF(HIGH,1)&&REF(HIGH,1)<REF(HIGH,2),REF(HIGH,2),0);
LL1:=IFELSE(LOW>REF(LOW,1)&&REF(LOW,1)>REF(LOW,2),REF(LOW,2),0);
HH2:=VALUEWHEN(HH1>0,HH1);
LL2:=VALUEWHEN(LL1>0,LL1);
HH:=HHV(HIGH,1)/10+HHV(HIGH,2)/10+HHV(HIGH,2)/10+HHV(HIGH,4)/10+HHV(HIGH,4)/10+HHV(HIGH,8)/10+HHV(HIGH,8)/10+HHV(HIGH,13)/10+HHV(HIGH,40)/10+HHV(HIGH,20)/10;
LL:=LLV(LOW,1)/10+LLV(LOW,2)/10+LLV(LOW,2)/10+LLV(LOW,4)/10+LLV(LOW,4)/10+LLV(LOW,8)/10+LLV(LOW,8)/10+LLV(LOW,13)/10+LLV(LOW,40)/10+LLV(LOW,20)/10;
H1:=IFELSE(HH<REF(HH,1)&&LL<REF(LL,1)&&REF(OPEN,1)>CLOSE&&OPEN>CLOSE&&(HHV(OPEN,0)-CLOSE)>0,REF(HH,2),0);
L1:=IFELSE(LL>REF(LL,1)&&HH>REF(HH,1)&&REF(OPEN,1)<CLOSE&&OPEN<CLOSE&&(CLOSE-LLV(OPEN,0))>0,REF(LL,2),0);
H2:=VALUEWHEN(H1>0,H1),LINETHICK2;
L2:=VALUEWHEN(L1>0,L1),LINETHICK2;
K1:=IFELSE(CLOSE>H2,-3,IFELSE(CLOSE<L2,1,0));
K2:=VALUEWHEN(K1<>0,K1);
G:=IFELSE(K2=1,H2,L2);
G1:=VALUEWHEN(ISLASTBAR,G);
DRAWNUMBER(LOW>0,G1,G1,0,COLORCYAN);
DRAWNUMBER(LL>0,G1,G1,0,COLORWHITE),ALIGN0,FONTSIZE30,VALIGN0;
HT:=IFELSE(OPEN>CLOSE,OPEN,CLOSE),LINETHICK2;
LT:=IFELSE(OPEN<CLOSE,OPEN,CLOSE),LINETHICK2;
DRAWLINE(K2=1,HIGH,K2=1,HT,COLORCYAN);
DRAWLINE(K2=1,LOW,K2=1,LT,COLORCYAN);
DRAWLINE(K2=-3,HIGH,K2=-3,HT,COLORRED);
DRAWLINE(K2=-3,LOW,K2=-3,LT,COLORRED);
STICKLINE(K2>0,OPEN,CLOSE,COLORCYAN,1);
STICKLINE(K2<=0,OPEN,CLOSE,COLORRED,1);
STICKLINE(OPEN-CLOSE>0&&K2<=0,OPEN,CLOSE,COLORRED,0);
STICKLINE(OPEN-CLOSE>0&&K2>0,OPEN,CLOSE,COLORCYAN,0);
PARTLINE(CLOSE<EMA2(HIGH,30),EMA2(HIGH,30),COLORGREEN),DASHDOTDOT;
PARTLINE(CLOSE>EMA2(LOW,30),EMA2(LOW,30),COLORMAGENTA),DASHDOTDOT;
PARTLINE(CLOSE>EMA2(LOW,30)&&CLOSE<EMA2(HIGH,30),0.2*EMA2(HIGH,30)+0.8*EMA2(LOW,30),COLORMAGENTA),DASHDOTDOT;
PARTLINE(CLOSE>EMA2(LOW,30)&&CLOSE<EMA2(HIGH,30),0.4*EMA2(HIGH,30)+0.6*EMA2(LOW,30),COLORMAGENTA),DASHDOTDOT;
PARTLINE(CLOSE>EMA2(LOW,30)&&CLOSE<EMA2(HIGH,30),0.6*EMA2(HIGH,30)+0.4*EMA2(LOW,30),COLORGREEN),DASHDOTDOT;
PARTLINE(CLOSE>EMA2(LOW,30)&&CLOSE<EMA2(HIGH,30),0.8*EMA2(HIGH,30)+0.2*EMA2(LOW,30),COLORGREEN),DASHDOTDOT;
DRAWLINE(K2=1&&REF(K2,1)=1,G,K2=1&&REF(K2,1)=1,REF(G,1),COLORCYAN),LINETHICK2;
DRAWLINE(K2=-3&&REF(K2,1)=-3,G,K2=-3&&REF(K2,1)=-3,REF(G,1),COLORRED),LINETHICK2;
DRAWSL(K2=1,G,0,1,0,COLORCYAN),LINETHICK2;
DRAWSL(K2=-3,G,0,1,0,COLORRED),LINETHICK2;
PARTLINE(CLOSE<EMA2(HIGH,150),EMA2(HIGH,150),COLORBLUE),LINETHICK3;
PARTLINE(CLOSE>EMA2(LOW,150),EMA2(LOW,150),COLORRED),LINETHICK3;
COND_X0_UPTODOWN:=HHV(HIGH,20)>H0.5M;
COND_X0_DOWNTOUP:=LLV(LOW,20)<L0.5M;
COND_X1_UP:=CROSS(CLOSE,EMA2(HIGH,30)) AND COND_X0_DOWNTOUP;
COND_X1_DOWN:=CROSS(EMA2(LOW,30),CLOSE) AND COND_X0_UPTODOWN;
COND_X2_UP:=K2=-3 AND REF(K2,1)=1 AND COND_X0_DOWNTOUP;
COND_X2_DOWN:=K2=1 AND REF(K2,1)=-3 AND COND_X0_UPTODOWN;
COND_X3_UP:=CROSS(CLOSE,EMA2(HIGH,150)) AND COND_X0_DOWNTOUP;
COND_X3_DOWN:=CROSS(EMA2(LOW,150),CLOSE) AND COND_X0_UPTODOWN;
COND_X1_UP,SELECT;
COND_X1_DOWN,SELECT;
COND_X1_UP,NOTICE('低阈短期看多');
COND_X1_DOWN,NOTICE('高阈短期看空');
DRAWTEXT(COND_X1_UP,CLOSE,'短多'),COLORRED,FONTSIZE18;
DRAWTEXT(COND_X1_DOWN,CLOSE,'短空'),COLORGREEN,FONTSIZE18;
COND_X1_UP,SOUND('A');
COND_X1_DOWN,SOUND('B');
COND_X2_UP,SELECT;
COND_X2_DOWN,SELECT;
COND_X2_UP,NOTICE('低阈中期看多');
COND_X2_DOWN,NOTICE('高阈中期看空');
DRAWTEXT(COND_X2_UP,CLOSE,'中多'),COLORRED,FONTSIZE24;
DRAWTEXT(COND_X2_DOWN,CLOSE,'中空'),COLORGREEN,FONTSIZE24;
DRAWGBK(K2=-3,RGB(0,0,0),RGB(100,0,0),0);
DRAWGBK(K2=1,RGB(0,0,0),RGB(0,100,0),0);
COND_X2_UP,SOUND('C');
COND_X2_DOWN,SOUND('D');
COND_X3_UP,SELECT;
COND_X3_DOWN,SELECT;
COND_X3_UP,NOTICE('低阈长期看多');
COND_X3_DOWN,NOTICE('高阈长期看空');
DRAWTEXT(COND_X3_UP,CLOSE,'长多'),COLORRED,FONTSIZE30;
DRAWTEXT(COND_X3_DOWN,CLOSE,'长空'),COLORGREEN,FONTSIZE30;
COND_X3_UP,SOUND('E');
COND_X3_DOWN,SOUND('F');

</CODE>
<VERSION>
130112
</VERSION>
<EDITTIME>
2026年09月28日22:15:43
</EDITTIME>
<PROPERTY>
0
</PROPERTY>
// END
