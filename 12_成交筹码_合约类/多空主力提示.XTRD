<CODE>
//多空主力提示
DIFF:=EMA(CLOSE,2)-EMA(CLOSE,55);
DEA:=EMA(DIFF,6);
MACD:=2*(DIFF-DEA);
QSX:SMA(((CLOSE-LLV(LOW,28))/(HHV(HIGH,28)-LLV(LOW,28))*100),3,1),COLORGREEN;
QSXMA:SMA(QSX,3,1),COLORFF00FF,LINETHICK2;
STICKLINE1(QSX>50,QSX,50,4,0),RGB(0,128,255);
STICKLINE1(50>QSX,QSX,50,4,0),RGB(0,106,53);
IF(QSX>50,QSX,NULL),COLORRED;
RSV:=(CLOSE-LLV(CLOSE,9))/(HHV(CLOSE,9)-LLV(CLOSE,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
TYP:=(HIGH+LOW+CLOSE)/3;
CCI:=(TYP-MA(TYP,14))/(0.015*AVEDEV(TYP,14));
TT:=IF(K>D AND CCI>0 AND DIFF>DEA AND MACD>0,1,0);
STICKLINE1(TT=1,50,50,6,0),COLORYELLOW;
STICKLINE1(TT=0,50,50,6,0),COLORCYAN;
IF(QSX>QSXMA,QSXMA,NULL),COLORYELLOW,LINETHICK2;
IF(QSX<QSXMA,QSXMA,NULL),COLORFFF000,LINETHICK2;
MAV:=(2*CLOSE+HIGH+LOW)/4;
VAR9:=LLV(LOW,34);
VAR7:=HHV(HIGH,34);
SK1:=EMA((MAV-VAR9)/(VAR7-VAR9)*100,13);
SD1:EMA(0.667*REF(SK1,1)+0.333*SK1,2);
80,POINTDOT;
20,POINTDOT;
50,POINTDOT;
DRAWTEXT(CROSS(SD1,16),20,'●多主力'),COLORYELLOW;
DRAWTEXT(CROSS(84,SD1),80,'●空主力'),COLORGREEN;
PLAYSOUND(CROSS(SD1,16),'A');
PLAYSOUND(CROSS(84,SD1),'B');

</CODE>
