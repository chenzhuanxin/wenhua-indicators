<CODE>
//远近高低阈
DRAWCOLORKLINE(ISUP,COLORRED,1);
DRAWCOLORKLINE(ISDOWN,COLORCYAN,1);
DRAWCOLORKLINE(ISEQUAL,COLORWHITE,1);
DRAWNUMBER(ISLASTBAR=1,CLOSE,CLOSE,PRECIS2,COLORYELLOW),ALIGN2,FONTSIZE22,VALIGN0;
峰值VA:=IF(ISCONTRACT('螺纹钢')=1,6208,0)+IF(ISCONTRACT('铁矿石')=1,1423,0)+IF(ISCONTRACT('沪铜')=1,89280,0)+IF(ISCONTRACT('沪金')=1,605.98,0)+IF(ISCONTRACT('原油')=1,823.6,0)+IF(ISCONTRACT('豆粕')=1,5086,0)+IF(ISCONTRACT('棕榈油')=1,13808,0)+IF(ISCONTRACT('白糖')=1,7948,0)+IF(ISCONTRACT('PTA')=1,12666,0)+IF(ISCONTRACT('甲醇')=1,4307,0),NODRAW;
谷值VA:=IF(ISCONTRACT('螺纹钢')=1,1567,0)+IF(ISCONTRACT('铁矿石')=1,277.5,0)+IF(ISCONTRACT('沪铜')=1,13610,0)+IF(ISCONTRACT('沪金')=1,175.46,0)+IF(ISCONTRACT('原油')=1,178.6,0)+IF(ISCONTRACT('豆粕')=1,1350,0)+IF(ISCONTRACT('棕榈油')=1,3866,0)+IF(ISCONTRACT('白糖')=1,3832,0)+IF(ISCONTRACT('PTA')=1,3028,0)+IF(ISCONTRACT('甲醇')=1,1419,0),NODRAW;
均值VA:=IF(ISCONTRACT('螺纹钢')=1,3604.16,0)+IF(ISCONTRACT('铁矿石')=1,584.55,0)+IF(ISCONTRACT('沪铜')=1,69218,0)+IF(ISCONTRACT('沪金')=1,330.11,0)+IF(ISCONTRACT('原油')=1,484,0)+IF(ISCONTRACT('豆粕')=1,2923.53,0)+IF(ISCONTRACT('棕榈油')=1,6320.03,0)+IF(ISCONTRACT('白糖')=1,5113.57,0)+IF(ISCONTRACT('PTA')=1,6543.59,0)+IF(ISCONTRACT('甲醇')=1,2471.37,0),NODRAW;
峰值:峰值VA,RGB(180,0,0),NODRAW;
谷值:谷值VA,RGB(0,180,0),NODRAW;
均值:均值VA,RGB(180,180,0),NODRAW;
H0.8M:0.8*峰值+0.2*均值,RGB(210,0,0),NODRAW;
L0.8M:0.8*谷值+0.2*均值,RGB(0,210,0),NODRAW;
系1:=0.1*HISEXPDAYS/365;
高阈:H0.8M-系1*(峰值-均值),COLORRED,LINETHICK2;
低阈:L0.8M-系1*(谷值-均值),COLORGREEN,LINETHICK2;
DRAWTEXT(CROSS(CLOSE,高阈),H,'上破高阈'),COLORRED;
DRAWTEXT(CROSS(低阈,CLOSE),L,'下破低阈'),COLORGREEN;

</CODE>
<VERSION>
130112
