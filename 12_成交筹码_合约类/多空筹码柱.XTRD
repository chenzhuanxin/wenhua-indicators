<CODE>
//多空筹码柱
//买盘/卖盘估算
买量:=VOL*(CLOSE-LOW)/(HIGH-LOW+0.0001);
卖量:=VOL*(HIGH-CLOSE)/(HIGH-LOW+0.0001);
多筹:SUM(买量,5)/SUM(VOL,5)*100,COLORRED,LINETHICK2;
空筹:SUM(卖量,5)/SUM(VOL,5)*100,COLORGREEN,LINETHICK2;
50,COLORGRAY,DOT;
//柱状显示
STICKLINE1(多筹>空筹,50,多筹,4,0),COLORRED;
STICKLINE1(空筹>多筹,50,空筹,4,0),COLORGREEN;
DRAWTEXT(CROSS(多筹,空筹),50,'多筹主导'),COLORRED;
DRAWTEXT(CROSS(空筹,多筹),50,'空筹主导'),COLORGREEN;

</CODE>
