<CODE>
//近远月合约指数强弱
//近月与远月对比（需按实际合约代码替换 9955/9956 等指数码）
近月:"9955$CLOSE",COLORRED,LINETHICK2;
远月:"9956$CLOSE",COLORCYAN,LINETHICK2;
差:近月-远月,COLORYELLOW,NODRAW;
强:=近月>远月;
PARTLINE(近月,强,COLORRED),LINETHICK3;
PARTLINE(近月,NOT(强),COLORGREEN),LINETHICK3;
DRAWTEXT(CROSS(近月,远月),L,'近月转强'),COLORRED;
DRAWTEXT(CROSS(远月,近月),H,'远月转强'),COLORGREEN;

</CODE>
<VERSION>
130112
</VERSION>
