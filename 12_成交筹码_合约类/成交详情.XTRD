<CODE>
//成交详情
DRAWNUMBER(ISLASTBAR=1,CLOSE,CLOSE,PRECIS2,COLORYELLOW),ALIGN2,FONTSIZE22,VALIGN0;
手数:VOL,NODRAW;
持仓:OPI,NODRAW;
增仓:OPI-REF(OPI,1),NODRAW;
换手:VOL/(OPI+0.0001)*100,NODRAW;
DRAWTEXT(ISLASTBAR=1,H,'量:'+NUMTOSTR(VOL,0)+' 仓:'+NUMTOSTR(OPI,0)),COLORWHITE,FONTSIZE18;
//量仓配合
量增仓增:=VOL>REF(VOL,1)&&OPI>REF(OPI,1);
量增仓减:=VOL>REF(VOL,1)&&OPI<REF(OPI,1);
DRAWTEXT(量增仓增&&CROSS(CLOSE,MA(CLOSE,5)),L,'量仓双增'),COLORRED;
DRAWTEXT(量增仓减&&CROSS(MA(CLOSE,5),CLOSE),H,'量增仓减'),COLORGREEN;

</CODE>
