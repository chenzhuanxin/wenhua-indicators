<CODE>
//SAR止损点买卖
DRAWCOLORKLINE(ISUP,COLORRED,1);
DRAWCOLORKLINE(ISDOWN,COLORCYAN,1);
DRAWCOLORKLINE(ISEQUAL,COLORWHITE,1);
STEP1:=2/100;
MVALUE1:=10/100;
SARLINE:=SAR(4,STEP1,MVALUE1),CIRCLEDOT;
AA:IF(SARLINE<0,ABS(SARLINE),NULL),CIRCLEDOT,COLORCYAN;
BB:IF(SARLINE>0,SARLINE,NULL),CIRCLEDOT,COLORRED;
KK2:=CROSS(SARLINE<0,0.5);
KK1:=BARSLAST(CROSS(CLOSE>VALUEWHEN(KK2,AA),0.5));
KK3:=CROSS(CLOSE>VALUEWHEN(KK2,AA),0.5);
DRAWTEXT(KK2&&COUNT(KK2,KK1)=1,AA,'高点'),COLORWHITE;
DRAWICON(KK2&&COUNT(KK2,KK1)=1,AA,5),VALIGN0;
KK3&&COUNT(CROSS(CLOSE>VALUEWHEN(KK2,AA),0.5),BARSLAST(KK2))=1,WORD(0,'上'),VALIGN0,COLORYELLOW;
DD1:=CROSS(SARLINE>0,0.5);
DD2:=BARSLAST(CROSS(CLOSE<VALUEWHEN(DD1,BB),0.5));
DD3:=CROSS(CLOSE<VALUEWHEN(DD1,BB),0.5);
DRAWTEXT(DD1&&COUNT(DD1,DD2)=1,BB,'低点'),VALIGN0,COLORRED;
DRAWICON(DD1&&COUNT(DD1,DD2)=1,BB,4);
DD3&&COUNT(CROSS(CLOSE<VALUEWHEN(DD1,BB),0.5),BARSLAST(DD1))=1,WORD(1,'下'),COLORGREEN;

</CODE>
