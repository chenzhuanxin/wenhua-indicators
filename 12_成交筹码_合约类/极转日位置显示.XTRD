<CODE>
//极转日位置显示
DRAWNUMBER(ISLASTBAR=1,1.01*HHV(HIGH,50),BARSCOUNT(CLOSE),PRECIS0,COLORYELLOW),FONTSIZE18;
DRAWTEXT(ISLASTBAR=1,1.01*HHV(HIGH,50),'         已运行K线数'),COLORYELLOW,FONTSIZE18;
//极值标识
HH:=HHV(HIGH,50);
LL:=LLV(LOW,50);
DRAWTEXT(ISLASTBAR=1,HH,'  极高位'),COLORRED,FONTSIZE18;
DRAWTEXT(ISLASTBAR=1,LL,'  极低位'),COLORGREEN,FONTSIZE18;

</CODE>
