<CODE>
//敏追钝避
MA5:=MA(CLOSE,5);
MA10:=MA(CLOSE,10);
//敏：快速响应追涨
敏:=CROSS(MA5,MA10)&&VOL>MA(VOL,5)*1.5;
//钝：迟钝规避
钝:=CROSS(MA10,MA5)&&CLOSE<MA10;
DRAWTEXT(敏,L,'敏·追'),COLORRED,FONTSIZE18;
DRAWTEXT(钝,H,'钝·避'),COLORGREEN,FONTSIZE18;
DRAWICON(敏,L,1);
DRAWICON(钝,H,2);

</CODE>
