<CODE>
//时间显示（月日时分秒）
DRAWNUMBER(ISLASTBAR=1,1.01*HHV(H,50),MONTH,PRECIS0,COLORYELLOW),FONTSIZE18;
DRAWNUMBER(ISLASTBAR=1,1.005*HHV(H,50),DAY,PRECIS0,COLORYELLOW),FONTSIZE18;
DRAWNUMBER(ISLASTBAR=1,HHV(H,50),HOUR,PRECIS0,COLORYELLOW),FONTSIZE18;
DRAWNUMBER(ISLASTBAR=1,0.995*HHV(H,50),MINUTE,PRECIS0,COLORYELLOW),FONTSIZE18;
DRAWNUMBER(ISLASTBAR=1,0.99*HHV(H,50),CURRENTTIME-60*INTPART(CURRENTTIME/60),PRECIS0,COLORYELLOW),FONTSIZE18;
DRAWTEXT(ISLASTBAR=1,1.01*HHV(H,50),'         月'),COLORYELLOW,FONTSIZE18;
DRAWTEXT(ISLASTBAR=1,1.005*HHV(H,50),'        日'),COLORYELLOW,FONTSIZE18;
DRAWTEXT(ISLASTBAR=1,HHV(H,50),'         时'),COLORYELLOW,FONTSIZE18;
DRAWTEXT(ISLASTBAR=1,0.995*HHV(H,50),'        分'),COLORYELLOW,FONTSIZE18;
DRAWTEXT(ISLASTBAR=1,0.99*HHV(H,50),'        秒'),COLORYELLOW,FONTSIZE18;

</CODE>
