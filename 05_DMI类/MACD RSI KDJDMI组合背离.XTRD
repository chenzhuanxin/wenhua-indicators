<CODE>
//MACD RSI KDJDMI 组合背离
//--- MACD
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
//--- RSI
LC:=REF(CLOSE,1);
RSI:=SMA(MAX(CLOSE-LC,0),14,1)/SMA(ABS(CLOSE-LC),14,1)*100;
//--- KDJ
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
//--- DMI
MTR:=SUM(MAX(MAX(HIGH-LOW,ABS(HIGH-REF(CLOSE,1))),ABS(LOW-REF(CLOSE,1))),14);
HD:=HIGH-REF(HIGH,1);
LD:=REF(LOW,1)-LOW;
DMP:=SUM(IF(HD>0&&HD>LD,HD,0),14);
DMM:=SUM(IF(LD>0&&LD>HD,LD,0),14);
PDI:DMP*100/MTR,COLORWHITE;
MDI:DMM*100/MTR,COLORYELLOW;
ADX:MA(ABS(MDI-PDI)/(MDI+PDI)*100,6),COLORMAGENTA;
//--- 四指标同时底背离
A:=BARSLAST(REF(CROSS(DIFF,DEA),1));
四底背:=REF(CLOSE,A+1)>CLOSE AND CROSS(DIFF,DEA) AND REF(RSI,A+1)<RSI AND REF(K,A+1)<K;
//--- 四指标同时顶背离
B:=BARSLAST(REF(CROSS(DEA,DIFF),1));
四顶背:=REF(CLOSE,B+1)<CLOSE AND CROSS(DEA,DIFF) AND REF(RSI,B+1)>RSI AND REF(K,B+1)>K;
DRAWTEXT(四底背,MDI,'组合底背离'),COLORRED,FONTSIZE18;
DRAWTEXT(四顶背,PDI,'组合顶背离'),COLORGREEN,FONTSIZE18;

</CODE>
