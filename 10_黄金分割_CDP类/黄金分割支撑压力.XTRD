<CODE>
//黄金分割支撑压力
H1:=HHV(HIGH,60);
L1:=LLV(LOW,60);
差:=H1-L1;
压力1:H1-差*0.191,COLORRED,DOT;
压力2:H1-差*0.382,COLORRED;
支撑1:L1+差*0.382,COLORGREEN;
支撑2:L1+差*0.191,COLORGREEN,DOT;
50%位:H1-差*0.5,COLORYELLOW,LINETHICK2;
DRAWTEXT(CROSS(CLOSE,50%位),L,'上穿中位'),COLORRED;
DRAWTEXT(CROSS(50%位,CLOSE),H,'下破中位'),COLORGREEN;

</CODE>
