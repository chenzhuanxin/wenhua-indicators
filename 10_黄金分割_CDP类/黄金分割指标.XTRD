<CODE>
//黄金分割指标
N:=60;
高:=HHV(HIGH,N);
低:=LLV(LOW,N);
差:=高-低;
H0.191:高-差*0.191,COLORWHITE,DOT;
H0.382:高-差*0.382,COLORYELLOW;
H0.5:高-差*0.5,COLORMAGENTA;
H0.618:高-差*0.618,COLORCYAN;
H0.809:高-差*0.809,COLORWHITE,DOT;
高:高,COLORRED,LINETHICK2;
低:低,COLORGREEN,LINETHICK2;
DRAWTEXT(CROSS(CLOSE,H0.618),L,'站上0.618'),COLORRED;
DRAWTEXT(CROSS(H0.382,CLOSE),H,'失守0.382'),COLORGREEN;

</CODE>
