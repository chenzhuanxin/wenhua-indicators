<CODE>
//CDP指标
PIVOT:=(HIGH+LOW+CLOSE*2)/4,COLORYELLOW,LINETHICK2;
压力1:2*PIVOT-LOW,COLORRED;
压力2:PIVOT+(HIGH-LOW),COLORRED,DOT;
压力3:HIGH+2*(PIVOT-LOW),COLORMAGENTA,DOT;
支撑1:2*PIVOT-HIGH,COLORGREEN;
支撑2:PIVOT-(HIGH-LOW),COLORGREEN,DOT;
支撑3:LOW-2*(HIGH-PIVOT),COLORCYAN,DOT;
DRAWTEXT(CROSS(CLOSE,压力1),H,'破压力1'),COLORRED;
DRAWTEXT(CROSS(支撑1,CLOSE),L,'破支撑1'),COLORGREEN;

</CODE>
