<CODE>
//KDJ黄金分割
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
H1:=HHV(HIGH,30);
L1:=LLV(LOW,30);
差:=H1-L1;
K0.382:K*0+ (H1-差*0.382),COLORYELLOW,DOT;
K0.618:K*0+ (H1-差*0.618),COLORCYAN,DOT;
DRAWTEXT(CROSS(K,D)&&K<50,L,'KDJ金叉·0.618'),COLORRED;
DRAWTEXT(CROSS(D,K)&&K>50,H,'KDJ死叉·0.382'),COLORGREEN;

</CODE>
