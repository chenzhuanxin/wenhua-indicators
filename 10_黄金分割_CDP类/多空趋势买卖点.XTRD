<CODE>
//多空趋势买卖点
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
H1:=HHV(HIGH,30);
L1:=LLV(LOW,30);
差:=H1-L1;
中位:H1-差*0.5,COLORYELLOW,DOT;
多:=CROSS(DIFF,DEA)&&CLOSE>中位;
空:=CROSS(DEA,DIFF)&&CLOSE<中位;
DRAWTEXT(多,L,'多趋势'),COLORRED,FONTSIZE20;
DRAWTEXT(空,H,'空趋势'),COLORGREEN,FONTSIZE20;
DRAWICON(多,L,1);
DRAWICON(空,H,2);

</CODE>
