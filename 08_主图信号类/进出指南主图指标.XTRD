<CODE>
//进出指南主图指标
E5:EMA(CLOSE,5),COLORWHITE;
E10:EMA(CLOSE,10),COLORYELLOW;
E20:EMA(CLOSE,20),COLORMAGENTA;
E30:EMA(CLOSE,30),COLORCYAN;
E60:EMA(CLOSE,60),COLORBLUE,LINETHICK2;
//RSI进逃
LC:=REF(CLOSE,1);
RSI:=SMA(MAX(CLOSE-LC,0),14,1)/SMA(ABS(CLOSE-LC),14,1)*100;
进:=CROSS(RSI,30)&&CLOSE>E5;
逃:=CROSS(70,RSI)&&CLOSE<E5;
DRAWTEXT(进,L,'进'),COLORRED,FONTSIZE22;
DRAWTEXT(逃,H,'逃'),COLORGREEN,FONTSIZE22;
DRAWICON(进,L,1);
DRAWICON(逃,H,2);

</CODE>
