<CODE>
//三色趋势跟踪
MA5:=MA(CLOSE,5);
MA10:=MA(CLOSE,10);
MA20:=MA(CLOSE,20);
多:=MA5>MA10&&MA10>MA20;
空:=MA5<MA10&&MA10<MA20;
DRAWCOLORKLINE(多,COLORRED,1);
DRAWCOLORKLINE(空,COLORCYAN,1);
DRAWCOLORKLINE(NOT(多)&&NOT(空),COLORYELLOW,1);

</CODE>
