<CODE>
//升落顶底
HLD1:=(CLOSE-MA(CLOSE,6))/MA(CLOSE,6)*100;
HLD2:=(CLOSE-MA(CLOSE,12))/MA(CLOSE,12)*100;
HLD3:=(CLOSE-MA(CLOSE,24))/MA(CLOSE,24)*100;
短期升落:HLD1,COLORWHITE;
中期升落:HLD2,COLORYELLOW;
长期升落:HLD3,COLORCYAN;
0,COLORGRAY,DOT;
//短顶短底
短顶:IF(CROSS(15,HLD1),15,NULL),COLORRED,POINTDOT;
短底:IF(CROSS(HLD1,-15),-15,NULL),COLORGREEN,POINTDOT;
//大顶大底
大顶:IF(CROSS(25,HLD1)&&HLD1<HLD2,25,NULL),COLORMAGENTA,POINTDOT;
大底:IF(CROSS(HLD1,-25)&&HLD1>HLD2,-25,NULL),COLORBLUE,POINTDOT;
DRAWTEXT(CROSS(15,HLD1),15,'短顶'),COLORRED;
DRAWTEXT(CROSS(HLD1,-15),-15,'短底'),COLORGREEN;
DRAWTEXT(CROSS(25,HLD1)&&HLD1<HLD2,25,'大顶'),COLORMAGENTA;
DRAWTEXT(CROSS(HLD1,-25)&&HLD1>HLD2,-25,'大底'),COLORBLUE;

</CODE>
<VERSION>
130112
</VERSION>
