<CODE>
//新款红蓝趋势跟踪（DRAWSHIFTNUMBER）
K1:=IFELSE(CLOSE>REF(HHV(H,9),1),1,IFELSE(CLOSE<REF(LLV(L,9),1),-1,0));
K2:=VALUEWHEN(K1<>0,K1);
G:=IFELSE(K2=1,REF(HHV(H,9),1),REF(LLV(L,9),1));
G1:=VALUEWHEN(ISLASTBAR,G);
DRAWCOLORKLINE((K2=1),COLORRED,1);
DRAWCOLORKLINE((K2=-1),COLORCYAN,1);
DRAWSHIFTNUMBER(ISLASTBAR,G1,G1,2,COLORYELLOW),FONTSIZE22;
DRAWSL(K2=1,G,0,1,0,COLORRED),LINETHICK2;
DRAWSL(K2=-1,G,0,1,0,COLORCYAN),LINETHICK2;

</CODE>
