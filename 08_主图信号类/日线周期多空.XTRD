<CODE>
//日线周期多空
MA5:=MA(CLOSE,5);
MA20:=MA(CLOSE,20);
多:=MA5>MA20&&CLOSE>MA5;
空:=MA5<MA20&&CLOSE<MA5;
DRAWCOLORKLINE(多,COLORRED,1);
DRAWCOLORKLINE(空,COLORCYAN,1);
DRAWCOLORKLINE(NOT(多)&&NOT(空),COLORWHITE,1);
DRAWTEXT(CROSS(MA5,MA20),L,'日线转多'),COLORRED;
DRAWTEXT(CROSS(MA20,MA5),H,'日线转空'),COLORGREEN;

</CODE>
