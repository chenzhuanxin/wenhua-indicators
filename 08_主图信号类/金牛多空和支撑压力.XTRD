<CODE>
//金牛多空和支撑压力
MA1:=EMA(CLOSE,8);
MA2:=EMA(CLOSE,21);
牛:=MA1>MA2;
熊:=MA1<MA2;
PARTLINE(MA1,牛,COLORRED),LINETHICK3;
PARTLINE(MA1,熊,COLORGREEN),LINETHICK3;
//支撑压力
HH:=HHV(HIGH,20);
LL:=LLV(LOW,20);
压力:HH,COLORRED,DOT;
支撑:LL,COLORGREEN,DOT;
DRAWTEXT(CROSS(CLOSE,HH),H,'破压力'),COLORRED;
DRAWTEXT(CROSS(LL,CLOSE),L,'破支撑'),COLORGREEN;

</CODE>
