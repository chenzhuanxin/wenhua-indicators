<CODE>
//多空突破交易提示
TR1:=MAX(MAX(HIGH-LOW,ABS(HIGH-REF(CLOSE,1))),ABS(LOW-REF(CLOSE,1)));
ATR:=MA(TR1,20);
上轨:=REF(HHV(HIGH,20),1);
下轨:=REF(LLV(LOW,20),1);
多突破:=CLOSE>上轨;
空突破:=CLOSE<下轨;
DRAWCOLORKLINE(多突破,COLORRED,0);
DRAWCOLORKLINE(空突破,COLORCYAN,0);
DRAWTEXT(多突破,L-ATR,'多突破'),COLORRED,FONTSIZE18;
DRAWTEXT(空突破,H+ATR,'空突破'),COLORGREEN,FONTSIZE18;
//止损提示
止损:IF(多突破,CLOSE-2*ATR,NULL),COLORMAGENTA,DOT;
止盈:IF(空突破,CLOSE+2*ATR,NULL),COLORMAGENTA,DOT;

</CODE>
