<CODE>
//经典指标山峰显现
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
MACD:=2*(DIFF-DEA);
山峰:=MACD=HHV(MACD,20)&&MACD>0&&MACD<REF(MACD,1);
山谷:=MACD=LLV(MACD,20)&&MACD<0&&MACD>REF(MACD,1);
DRAWTEXT(山峰,H,'山峰'),COLORGREEN,FONTSIZE20;
DRAWTEXT(山谷,L,'山谷'),COLORRED,FONTSIZE20;
DRAWICON(山峰,H,2);
DRAWICON(山谷,L,1);

</CODE>
