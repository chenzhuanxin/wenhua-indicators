<CODE>
//顺势（红蓝趋势基本款）
K1:=IFELSE(CLOSE>HHV(REF(HIGH,1),2),1,IFELSE(CLOSE<LLV(REF(LOW,1),2),-1,0));
K2:=VALUEWHEN(K1<>0,K1);
DRAWCOLORKLINE((K2=1),COLORRED,1);
DRAWCOLORKLINE((K2=-1),COLORCYAN,1);

</CODE>
