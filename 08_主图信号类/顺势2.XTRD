<CODE>
//顺势2（红蓝K线）
K1:=IFELSE(CLOSE>HHV(REF(HIGH,1),3),1,IFELSE(CLOSE<LLV(REF(LOW,1),3),-1,0));
K2:=VALUEWHEN(K1<>0,K1);
DRAWCOLORKLINE((K2=1),COLORRED,1);
DRAWCOLORKLINE((K2=-1),COLORCYAN,1);
DRAWCOLORKLINE((K2=0)&&ISUP,COLORWHITE,1);
DRAWCOLORKLINE((K2=0)&&ISDOWN,COLORWHITE,0);

</CODE>
