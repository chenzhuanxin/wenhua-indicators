<CODE>
//多空线
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
B0:=DIFF-DEA;
B1:=MA(B0,3);
B:MA(B1,3),COLORYELLOW,LINETHICK2;
0,COLORGRAY,DOT;
//底部顶部
底部:=CROSS(B,0)&&B0>0;
顶部:=CROSS(0,B)&&B0<0;
DRAWCOLORKLINE(底部,COLORRED,0);
DRAWCOLORKLINE(顶部,COLORCYAN,0);
DRAWTEXT(底部,L,'底部'),COLORRED,FONTSIZE20;
DRAWTEXT(顶部,H,'顶部'),COLORGREEN,FONTSIZE20;

</CODE>
