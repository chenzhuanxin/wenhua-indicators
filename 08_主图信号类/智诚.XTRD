<CODE>
//智诚
DRAWCOLORKLINE(ISUP,COLORRED,1);
DRAWCOLORKLINE(ISDOWN,COLORCYAN,1);
BICCUP1:=MA((CLOSE-MA(CLOSE,13))/MA(CLOSE,13),3)*100,COLORWHITE;
BICCUP3:=MA((CLOSE-MA(CLOSE,34))/MA(CLOSE,34),3)*100,COLORFF00FF;
TT1:=COUNT(BICCUP3<0,8)>=8 AND COUNT(BICCUP3>0,34)>13 AND COUNT(BICCUP3<0,55)>30 OR BICCUP3<-15;
STICKLINE1(TT1,CLOSE,OPEN,3,0),COLOR8977FF;
STICKLINE1(TT1,LOW,HIGH,0,0),COLOR8977FF;
TT2:=CROSS(BICCUP1,0) AND SUM(IF(BICCUP3<-15,10,0),8)>10;
STICKLINE1(TT2,CLOSE,OPEN,3,0),COLOR0066BB;
STICKLINE1(TT2,CLOSE,OPEN,2,0),COLOR0099CC;
STICKLINE1(TT2,CLOSE,OPEN,1,0),COLOR00CCEE;
STICKLINE1(TT2,CLOSE,OPEN,0.1,0),COLOR00FFFF;
DRAWTEXT(TT2,LOW,'出击'),COLOR0000FF,VALIGN0;

</CODE>
