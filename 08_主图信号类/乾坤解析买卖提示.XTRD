<CODE>
//乾坤解析买卖提示
乾:=EMA(CLOSE,5);
坤:=EMA(CLOSE,20);
买:=CROSS(乾,坤);
卖:=CROSS(坤,乾);
DRAWCOLORKLINE(买,COLORRED,0);
DRAWCOLORKLINE(卖,COLORCYAN,0);
DRAWTEXT(买,L,'乾上坤下·买'),COLORRED,FONTSIZE18;
DRAWTEXT(卖,H,'坤上乾下·卖'),COLORGREEN,FONTSIZE18;
乾:乾,COLORYELLOW,LINETHICK2;
坤:坤,COLORCYAN,LINETHICK2;

</CODE>
