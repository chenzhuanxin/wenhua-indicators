<CODE>
//主图MACD指标
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
MACD:=2*(DIFF-DEA);
DRAWCOLORKLINE(MACD>0&&MACD>REF(MACD,1),COLORRED,1);
DRAWCOLORKLINE(MACD>0&&MACD<REF(MACD,1),COLORMAGENTA,1);
DRAWCOLORKLINE(MACD<0&&MACD<REF(MACD,1),COLORCYAN,1);
DRAWCOLORKLINE(MACD<0&&MACD>REF(MACD,1),COLORGREEN,1);
FILLRGN1(MACD>0,HHV(H,1),LLV(L,1),RGB(100,0,0));
FILLRGN1(MACD<0,HHV(H,1),LLV(L,1),RGB(0,80,0));

</CODE>
