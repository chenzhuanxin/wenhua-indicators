<CODE>
//CTA中线多空配合顶底
MID:=EMA(CLOSE,40);
多:=CLOSE>MID;
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
//中线多 + 顶底
买:=多&&CROSS(K,D)&&K<30;
卖:=NOT(多)&&CROSS(D,K)&&K>70;
DRAWCOLORKLINE(买,COLORRED,0);
DRAWCOLORKLINE(卖,COLORCYAN,0);
DRAWTEXT(买,L,'中线多'),COLORRED,FONTSIZE18;
DRAWTEXT(卖,H,'中线空'),COLORGREEN,FONTSIZE18;
中线:MID,COLORYELLOW,LINETHICK2;

</CODE>
