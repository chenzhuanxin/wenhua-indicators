<CODE>
//单多操盘提示
MA5:=MA(CLOSE,5);
MA13:=MA(CLOSE,13);
多:=CROSS(MA5,MA13)&&CLOSE>MA13;
单:=CROSS(MA13,MA5)&&CLOSE<MA13;
DRAWTEXT(多,L,'多单'),COLORRED,FONTSIZE20;
DRAWTEXT(单,H,'空单'),COLORGREEN,FONTSIZE20;
DRAWICON(多,L,1);
DRAWICON(单,H,2);

</CODE>
