<CODE>
//回归趋势日线跟踪
N:=20;
中轨:MA(CLOSE,N),COLORYELLOW,LINETHICK2;
//线性回归斜率
X1:=BARPOS-BARSLAST(BARPOS=1);
斜率:SLOPE(CLOSE,N),COLORWHITE,LINETHICK2;
0,COLORGRAY,DOT;
上升:斜率>0&&CLOSE>中轨;
下降:斜率<0&&CLOSE<中轨;
DRAWCOLORKLINE(上升,COLORRED,1);
DRAWCOLORKLINE(下降,COLORCYAN,1);

</CODE>
