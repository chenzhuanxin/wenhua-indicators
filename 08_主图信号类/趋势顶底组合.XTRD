<CODE>
//趋势顶底组合
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
//顶：MACD死叉 且 KDJ高位
顶:=CROSS(DEA,DIFF)&&K>70;
底:=CROSS(DIFF,DEA)&&K<30;
DRAWCOLORKLINE(顶,COLORCYAN,0);
DRAWCOLORKLINE(底,COLORRED,0);
DRAWTEXT(顶,H,'趋势顶'),COLORGREEN,FONTSIZE20;
DRAWTEXT(底,L,'趋势底'),COLORRED,FONTSIZE20;

</CODE>
