<CODE>
//阶梯主图指标
MA7:=MA(CLOSE,7);
MA13:=MA(CLOSE,13);
MA21:=MA(CLOSE,21);
//阶梯向上
阶梯上:=MA7>REF(MA7,1)&&MA13>REF(MA13,1)&&MA21>REF(MA21,1);
阶梯下:=MA7<REF(MA7,1)&&MA13<REF(MA13,1)&&MA21<REF(MA21,1);
PARTLINE(MA7,阶梯上,COLORRED),LINETHICK3;
PARTLINE(MA7,阶梯下,COLORGREEN),LINETHICK3;
PARTLINE(MA7,NOT(阶梯上)&&NOT(阶梯下),COLORYELLOW),LINETHICK2;
MA7:MA7,COLORWHITE;
MA13:MA13,COLORYELLOW;
MA21:MA21,COLORCYAN;
DRAWTEXT(CROSS(MA7,MA13)&&阶梯上,L,'阶梯起'),COLORRED;
DRAWTEXT(CROSS(MA13,MA7)&&阶梯下,H,'阶梯落'),COLORGREEN;

</CODE>
