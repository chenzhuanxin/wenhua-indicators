<CODE>
//通道操盘买卖提示
N:=20;
P:=2;
MID:=MA(CLOSE,N);
TR1:=MAX(MAX(HIGH-LOW,ABS(HIGH-REF(CLOSE,1))),ABS(LOW-REF(CLOSE,1)));
ATR:=MA(TR1,N);
上轨:MID+P*ATR,COLORRED,LINETHICK2;
下轨:MID-P*ATR,COLORGREEN,LINETHICK2;
中轨:MID,COLORYELLOW;
买:=CROSS(CLOSE,下轨);
卖:=CROSS(上轨,CLOSE);
DRAWTEXT(买,L,'通道买'),COLORRED,FONTSIZE18;
DRAWTEXT(卖,H,'通道卖'),COLORGREEN,FONTSIZE18;

</CODE>
