<CODE>
//红蓝趋势跟踪
K1:=IFELSE(CLOSE>REF(HHV(H,6),1),1,IFELSE(CLOSE<REF(LLV(L,6),1),-1,0));
K2:=VALUEWHEN(K1<>0,K1);
G:=IFELSE(K2=1,REF(HHV(H,6),1),REF(LLV(L,6),1));
DRAWCOLORKLINE((K2=1),COLORRED,1);
DRAWCOLORKLINE((K2=-1),COLORCYAN,1);
DRAWSL(K2=1,G,0,1,0,COLORRED),LINETHICK2;
DRAWSL(K2=-1,G,0,1,0,COLORCYAN),LINETHICK2;

</CODE>
