<CODE>
//红升蓝降黄盘整
MA5:=MA(CLOSE,5);
MA10:=MA(CLOSE,10);
上升:=MA5>MA10&&CLOSE>MA5;
下降:=MA5<MA10&&CLOSE<MA5;
DRAWCOLORKLINE(上升&&ISUP,COLORRED,0);
DRAWCOLORKLINE(下降&&ISDOWN,COLORCYAN,0);
DRAWCOLORKLINE(NOT(上升)&&NOT(下降),COLORYELLOW,0);
DRAWTEXT(CROSS(MA5,MA10),L,'红升'),COLORRED;
DRAWTEXT(CROSS(MA10,MA5),H,'蓝降'),COLORBLUE;

</CODE>
