<CODE>
//经典指标即刻买卖
DRAWCOLORKLINE(ISUP,COLORRED,1);
DRAWCOLORKLINE(ISDOWN,COLORCYAN,1);
DRAWCOLORKLINE(ISEQUAL,COLORWHITE,1);
BICCUP1:=MA((CLOSE-MA(CLOSE,13))/MA(CLOSE,13),3)*100,COLORWHITE;
BICCUP3:=MA((CLOSE-MA(CLOSE,34))/MA(CLOSE,34),3)*100,COLORFF00FF;
TT1:=COUNT(BICCUP3<0,8)>=8 AND COUNT(BICCUP3>0,34)>13 AND COUNT(BICCUP3<0,55)>30 OR BICCUP3<-15;
STICKLINE1(TT1,CLOSE,OPEN,3,0),COLOR8977FF;
STICKLINE1(TT1,LOW,HIGH,0,0),COLOR8977FF;
TT2:=CROSS(BICCUP1,0) AND SUM(IF(BICCUP3<-15,10,0),8)>10;
STICKLINE1(TT2,CLOSE,OPEN,3,0),COLOR0066BB;
STICKLINE1(TT2,CLOSE,OPEN,2,0),COLOR0099CC;
STICKLINE1(TT2,CLOSE,OPEN,1,0),COLOR00CCEE;
STICKLINE1(TT2,CLOSE,OPEN,0.1,0),COLOR00FFFF;
STICKLINE1(TT2,LOW,HIGH,0,0),COLOR00FFFF;
DRAWTEXT(TT2,LOW,'出击'),COLOR0000FF,VALIGN0;
LC:=REF(CLOSE,1);
RSI:=SMA(MAX(CLOSE-LC,0),13,1)/SMA(ABS(CLOSE-LC),13,1)*100;
STICKLINE1((RSI<20),LOW,HIGH,0.1,0),COLORFF6600;
STICKLINE1((RSI<20),OPEN,CLOSE,8,0),COLORCC5000;
DRAWTEXT(CROSS(RSI,20-0.0005),LOW,'牛'),COLORAA99AA,VALIGN0;
STICKLINE1(CROSS(RSI,20-0.0005),CLOSE,OPEN,3,0),COLOR888888;
STICKLINE1(CROSS(RSI,20-0.0005),CLOSE,OPEN,2,0),COLORAAAAAA;
STICKLINE1(CROSS(RSI,20-0.0005),CLOSE,OPEN,1,0),COLORCCCCCC;
STICKLINE1(CROSS(RSI,20-0.0005),CLOSE,OPEN,0.1,0),COLORFFFFFF;
STICKLINE1(CROSS(RSI,20-0.0005),LOW,HIGH,0,0),COLORFFFFFF;
RSV:=((CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9)))*100;
RSI31:=SMA(RSV,3,1);
D:=SMA(RSI31,3,1);
TT4:=((CLOSE>LC) AND CLOSE>OPEN);
HHRSI:=HHV(D,5);
D1:=REF(D,1);
STICKLINE1(((HHRSI>75) AND CROSS(D,RSI31)),CLOSE,OPEN,3,0),COLOR008800;
STICKLINE1(((HHRSI>75) AND CROSS(D,RSI31)),CLOSE,OPEN,2,0),COLOR00AA00;
STICKLINE1(((HHRSI>75) AND CROSS(D,RSI31)),CLOSE,OPEN,1,0),COLOR00CC00;
STICKLINE1(((HHRSI>75) AND CROSS(D,RSI31)),CLOSE,OPEN,0.1,0),COLOR00FF00;
STICKLINE1(((HHRSI>75) AND CROSS(D,RSI31)),LOW,HIGH,0,0),COLOR00FF00;
STICKLINE1((((D1<30) AND CROSS(RSI31,D)) AND TT4),CLOSE,OPEN,3,0),COLOR0011FF;
STICKLINE1((((D1<30) AND CROSS(RSI31,D)) AND TT4),CLOSE,OPEN,2,0),COLOR0044FF;
STICKLINE1((((D1<30) AND CROSS(RSI31,D)) AND TT4),CLOSE,OPEN,1,0),COLOR0077FF;
STICKLINE1((((D1<30) AND CROSS(RSI31,D)) AND TT4),CLOSE,OPEN,0.1,0),COLOR0099FF;
STICKLINE1((((D1<30) AND CROSS(RSI31,D)) AND TT4),LOW,HIGH,0,0),COLOR0099FF;
DRAWTEXT((((D1<30) AND CROSS(RSI31,D)) AND TT4),LOW,'立刻出击'),COLOR0066FF,VALIGN0;
DRAWTEXT((((D1<30) AND CROSS(RSI31,D)) AND TT4),LOW,'↑买'),COLORFFAAFF,VALIGN0;
DRAWTEXT(((HHRSI>75) AND CROSS(D,RSI31)),HIGH,'↓卖'),COLOR00CC00,VALIGN2;
GXL1:=MA(CLOSE,13);
GXL:=ATAN((GXL1-REF(GXL1,1)))*180/2;
STICKLINE1(GXL>1 AND GXL1>REF(GXL1,1),GXL1,REF(GXL1,1),5,0),COLOR00FFFF;
STICKLINE1(GXL<1 AND GXL1<REF(GXL1,1),GXL1,REF(GXL1,1),5,1),COLORGREEN;
GXL2:=MA(CLOSE,21);
GXL3:=ATAN((GXL2-REF(GXL2,1)))*180/2;
STICKLINE1(GXL3>1,GXL2,REF(GXL2,1),5,0),COLORFF00FF;
STICKLINE1(GXL3<1,GXL2,REF(GXL2,1),5,1),COLORFF0000;

</CODE>
<VERSION>
130112
</VERSION>
<EDITTIME>
2026年09月28日22:15:43
</EDITTIME>
<PROPERTY>
0
</PROPERTY>
