<CODE>
//综合波段交易提示
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
//波段买
买:=CROSS(DIFF,DEA)&&CROSS(K,D)&&K<50;
卖:=CROSS(DEA,DIFF)&&CROSS(D,K)&&K>50;
DRAWCOLORKLINE(买,COLORRED,0);
DRAWCOLORKLINE(卖,COLORCYAN,0);
DRAWTEXT(买,L,'波段买'),COLORRED,FONTSIZE20;
DRAWTEXT(卖,H,'波段卖'),COLORGREEN,FONTSIZE20;
DRAWICON(买,L,1);
DRAWICON(卖,H,2);

</CODE>
<VERSION>
130112
