<CODE>
//小神助攻顶底指标
VAR1:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
VAR2:=SMA(VAR1,3,1);
VAR3:=SMA(VAR2,3,1);
VAR4:=3*VAR2-2*VAR3;
//顶底
底:IF(CROSS(VAR2,VAR3)&&VAR2<20,20,NULL),COLORRED,POINTDOT;
顶:IF(CROSS(VAR3,VAR2)&&VAR2>80,80,NULL),COLORGREEN,POINTDOT;
DRAWTEXT(CROSS(VAR2,VAR3)&&VAR2<20,20,'小神助攻'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(VAR3,VAR2)&&VAR2>80,80,'小神逃顶'),COLORGREEN,FONTSIZE18;
VAR2:VAR2,COLORWHITE;
VAR3:VAR3,COLORYELLOW;
20,COLORGRAY,DOT;
80,COLORGRAY,DOT;

</CODE>
