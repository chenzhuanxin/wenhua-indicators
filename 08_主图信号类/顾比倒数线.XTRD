<CODE>
//顾比倒数线
P:=21;
//顾比倒数线：从最近 P 周期极值向前找两个更高高点
HH:=HHV(H,P);
LL:=LLV(L,P);
高1:=VALUEWHEN(H=HH,H);
高2:=REF(高1,BARSLAST(H=HH)+1);
顾比上:IF(H=HH,VALUEWHEN(BARSLAST(H=HHV(H,P))>0,REF(H,BARSLAST(H=HHV(H,P)))),NULL),COLORRED,LINETHICK2;
顾比下:IF(L=LL,VALUEWHEN(BARSLAST(L=LLV(L,P))>0,REF(L,BARSLAST(L=LLV(L,P)))),NULL),COLORGREEN,LINETHICK2;
DRAWLINE(H=HH,H,1,MAX(CLOSE,OPEN),COLORRED);
DRAWLINE(L=LL,L,1,MIN(CLOSE,OPEN),COLORGREEN);
DRAWTEXT(CROSS(CLOSE,REF(H,BARSLAST(H=HH))),L,'顾比突破'),COLORRED;
DRAWTEXT(CROSS(REF(L,BARSLAST(L=LL)),CLOSE),H,'顾比破位'),COLORGREEN;

</CODE>
