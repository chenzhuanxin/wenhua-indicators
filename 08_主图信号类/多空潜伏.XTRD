<CODE>
//多空潜伏
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
//潜伏多：低位金叉且量能温和
潜伏多:=CROSS(DIFF,DEA)&&DIFF<0&&K<50;
潜伏空:=CROSS(DEA,DIFF)&&DIFF>0&&K>50;
DRAWCOLORKLINE(潜伏多,COLORRED,0);
DRAWCOLORKLINE(潜伏空,COLORCYAN,0);
DRAWTEXT(潜伏多,L,'潜伏多'),COLORRED,FONTSIZE20;
DRAWTEXT(潜伏空,H,'潜伏空'),COLORGREEN,FONTSIZE20;

</CODE>
