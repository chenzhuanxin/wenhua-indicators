<CODE>
//买卖区间主图指标
买线:EMA(CLOSE,3),COLORRED,LINETHICK2;
卖线:EMA(CLOSE,21),COLORGREEN,LINETHICK2;
//一阳穿三线
MA5:=MA(CLOSE,5);
MA10:=MA(CLOSE,10);
MA20:=MA(CLOSE,20);
一阳穿三:=CLOSE>MA5&&CLOSE>MA10&&CLOSE>MA20&&OPEN<MIN(MIN(MA5,MA10),MA20)&&CLOSE>OPEN;
一阴穿三:=CLOSE<MA5&&CLOSE<MA10&&CLOSE<MA20&&OPEN>MAX(MAX(MA5,MA10),MA20)&&CLOSE<OPEN;
DRAWTEXT(一阳穿三,L,'买'),COLORRED,FONTSIZE22;
DRAWTEXT(一阴穿三,H,'卖'),COLORGREEN,FONTSIZE22;
DRAWCOLORKLINE(一阳穿三,COLORRED,0);
DRAWCOLORKLINE(一阴穿三,COLORCYAN,0);

</CODE>
