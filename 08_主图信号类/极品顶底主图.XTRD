<CODE>
//极品顶底主图
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
J:=3*K-2*D;
//顶部来临
顶部:=CROSS(D,K)&&J>90&&CLOSE<OPEN;
//底部来临
低部:=CROSS(K,D)&&J<10&&CLOSE>OPEN;
DRAWCOLORKLINE(顶部,COLORCYAN,0);
DRAWCOLORKLINE(低部,COLORRED,0);
DRAWTEXT(顶部,H,'顶部来临'),COLORGREEN,FONTSIZE20;
DRAWTEXT(低部,L,'底部来临'),COLORRED,FONTSIZE20;
DRAWICON(顶部,H,2);
DRAWICON(低部,L,1);

</CODE>
