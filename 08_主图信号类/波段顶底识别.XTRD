<CODE>
//波段顶底识别
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
顶:CROSS(D,K)&&K>80;
底:CROSS(K,D)&&K<20;
DRAWTEXT(顶,H,'波段顶'),COLORGREEN,FONTSIZE18;
DRAWTEXT(底,L,'波段底'),COLORRED,FONTSIZE18;
DRAWICON(顶,H,2);
DRAWICON(底,L,1);

</CODE>
