<CODE>
//顺势4
MA1:=MA(CLOSE,7);
MA2:=MA(CLOSE,21);
MA3:=MA(CLOSE,55);
多头排列:=MA1>MA2&&MA2>MA3;
空头排列:=MA1<MA2&&MA2<MA3;
PARTLINE(MA1,多头排列,COLORRED),LINETHICK3;
PARTLINE(MA1,空头排列,COLORGREEN),LINETHICK3;
PARTLINE(MA1,NOT(多头排列)&&NOT(空头排列),COLORYELLOW),LINETHICK2;
MA1:MA1,COLORWHITE;
MA2:MA2,COLORYELLOW;
MA3:MA3,COLORCYAN;
//买点
DRAWTEXT(CROSS(MA1,MA2)&&MA2>MA3,L,'回踩买'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(MA2,MA1)&&MA2<MA3,H,'反弹空'),COLORGREEN,FONTSIZE18;

</CODE>
