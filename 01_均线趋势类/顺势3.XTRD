<CODE>
//顺势3
VAR1:=(CLOSE+HIGH+LOW)/3;
VAR2:=EMA(VAR1,10);
VAR3:=EMA(VAR1,30);
多头:=VAR2>VAR3;
K1:=IFELSE(CLOSE>REF(HHV(H,5),1),1,IFELSE(CLOSE<REF(LLV(L,5),1),-1,0));
K2:=VALUEWHEN(K1<>0,K1);
DRAWCOLORKLINE((K2=1),COLORRED,1);
DRAWCOLORKLINE((K2=-1),COLORCYAN,1);
PARTLINE(VAR2,多头,COLORRED),LINETHICK2;
PARTLINE(VAR2,NOT(多头),COLORGREEN),LINETHICK2;
DRAWTEXT(CROSS(VAR2,VAR3),L,'多'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(VAR3,VAR2),H,'空'),COLORGREEN,FONTSIZE18;

</CODE>
