<CODE>
//趋势三号
VARCC:=SMA(MAX(CLOSE-REF(CLOSE,1),0),7,1)/SMA(ABS(CLOSE-REF(CLOSE,1)),7,1)*100;
QUSHI:=EMA(VARCC,3);
//三号趋势线
趋势:EMA(EMA(QUSHI,5),5),COLORRED,LINETHICK2;
平衡:50,COLORGRAY,DOT;
//多空提示
DQ:IF(趋势>REF(趋势,1)&&趋势>50,趋势,NULL),COLORRED,LINETHICK3;
KQ:IF(趋势<REF(趋势,1)&&趋势<50,趋势,NULL),COLORGREEN,LINETHICK3;
DRAWTEXT(CROSS(趋势,50),50,'趋势转多'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(50,趋势),50,'趋势转空'),COLORGREEN,FONTSIZE18;

</CODE>
