<CODE>
//溪水线
VAR1:=(HIGH+LOW+CLOSE*2)/4;
VAR2:=EMA(VAR1,13);
VAR3:=STD(VAR1,13);
VAR4:=((VAR1-VAR2)*100/VAR3+200)/2;
溪水:EMA(VAR4,5),COLORCYAN,LINETHICK2;
分水岭:50,COLORYELLOW,DOT;
//多空区
DRAWGBK(溪水>50,RGB(0,0,0),RGB(80,0,0),0);
DRAWGBK(溪水<50,RGB(0,0,0),RGB(0,80,0),0);
DRAWTEXT(CROSS(溪水,50),50,'上水'),COLORRED;
DRAWTEXT(CROSS(50,溪水),50,'下水'),COLORGREEN;

</CODE>
