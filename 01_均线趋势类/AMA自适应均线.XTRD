<CODE>
//AMA自适应均线（Kaufman）
N:=10;
FASTSC:=2/(2+1);
SLOWSC:=2/(30+1);
DIRECTION:=ABS(CLOSE-REF(CLOSE,N));
VOLATILITY:=SUM(ABS(CLOSE-REF(CLOSE,1)),N);
ER:=IF(VOLATILITY=0,0,DIRECTION/VOLATILITY);
SSC:=ER*(FASTSC-SLOWSC)+SLOWSC;
CONST:=SSC*SSC;
AMA:IF(BARPOS=1,CLOSE,REF(AMA,1)+CONST*(CLOSE-REF(AMA,1))),COLORYELLOW,LINETHICK2;
//方向提示
PARTLINE(CLOSE>AMA,AMA,COLORRED),LINETHICK2;
PARTLINE(CLOSE<AMA,AMA,COLORGREEN),LINETHICK2;
DRAWTEXT(CROSS(CLOSE,AMA),L,'多'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(AMA,CLOSE),H,'空'),COLORGREEN,FONTSIZE18;

</CODE>
