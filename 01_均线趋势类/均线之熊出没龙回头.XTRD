<CODE>
//均线之熊出没龙回头
MA5:=MA(CLOSE,5);
MA10:=MA(CLOSE,10);
MA20:=MA(CLOSE,20);
MA60:=MA(CLOSE,60);
//多头排列
DQ:=MA5>MA10&&MA10>MA20;
//龙回头：缩量回踩10日线后再起
HUISHEN:=COUNT(CLOSE<MA10,5)>=2&&CLOSE>MA10&&MA5>MA10;
DRAWTEXT(HUISHEN&&DQ,L,'龙回头'),COLORRED,FONTSIZE18;
//熊出没：跌破60日线
XIONG:=CROSS(MA60,CLOSE);
DRAWTEXT(XIONG,H,'熊出没'),COLORGREEN,FONTSIZE18;
//均线绘制
MA5:MA5,COLORWHITE;
MA10:MA10,COLORYELLOW;
MA20:MA20,COLORMAGENTA;
MA60:MA60,COLORCYAN,LINETHICK2;

</CODE>
