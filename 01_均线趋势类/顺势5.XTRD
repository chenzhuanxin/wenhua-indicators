<CODE>
//顺势5
粗线:=EMA(CLOSE,13);
细线:=EMA(CLOSE,34);
趋势线:EMA(CLOSE,89),COLORGRAY,LINETHICK2;
//多空带
PARTLINE(粗线>细线,粗线,COLORRED),LINETHICK3;
PARTLINE(粗线<细线,粗线,COLORGREEN),LINETHICK3;
粗线:粗线,COLORWHITE,LINETHICK2;
细线:细线,COLORYELLOW;
//信号
DRAWTEXT(CROSS(粗线,细线),L,'金叉'),COLORRED,FONTSIZE20;
DRAWTEXT(CROSS(细线,粗线),H,'死叉'),COLORGREEN,FONTSIZE20;
//止损
止损:CLOSE-2*ATR,COLORMAGENTA,DOT;

</CODE>
