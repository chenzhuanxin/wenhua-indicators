<CODE>
//赢益趋势
LHS:IF(DATE>910420,NULL,1),NODRAW;
A:=EMA2(HIGH,30);
B:=EMA2(LOW,30);
A1:=EMA2(HIGH,150),LINETHICK2;
B1:=EMA2(LOW,150),LINETHICK2;
A2:=EMA2(HIGH,60),LINETHICK2;
B2:=EMA2(LOW,60),LINETHICK2;
//短中期趋势判断
短期趋势:IF(A>REF(A,1)&&B>REF(B,1),1,0),NODRAW;
//长期趋势判断
PARTLINE(CLOSE<A1,A1,COLORBLUE),LINETHICK3;
PARTLINE(CLOSE>B1,B1,COLORRED),LINETHICK3;
//中期趋势判断
PARTLINE(CLOSE<A2,A2,COLORGREEN),LINETHICK2;
PARTLINE(CLOSE>B2,B2,COLORMAGENTA),LINETHICK2;
//短期趋势判断线
PARTLINE(CLOSE<A,A,COLORGREEN),DASHDOTDOT;
PARTLINE(CLOSE>B,B,COLORMAGENTA),DASHDOTDOT;
//MACD顶底点
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
MACD:=2*(DIFF-DEA);
//顶底提示
DRAWTEXT(CROSS(DIFF,DEA)&&DIFF<0,L,'底'),COLORRED;
DRAWTEXT(CROSS(DEA,DIFF)&&DIFF>0,H,'顶'),COLORGREEN;

</CODE>
