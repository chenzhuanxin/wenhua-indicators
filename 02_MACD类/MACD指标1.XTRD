<CODE>
//MACD指标1
DIFF:EMA(CLOSE,12)-EMA(CLOSE,26),COLORWHITE;
DEA:EMA(DIFF,9),COLORYELLOW;
MACD:2*(DIFF-DEA),COLORSTICK;
//零轴
0,COLORGRAY,DOT;
//金叉死叉
JC:=CROSS(DIFF,DEA);
SC:=CROSS(DEA,DIFF);
底金叉:CROSS(DIFF,DEA)&&DIFF<0,NODRAW;
顶死叉:CROSS(DEA,DIFF)&&DIFF>0,NODRAW;
DRAWICON(底金叉,DIFF,1);
DRAWICON(顶死叉,DIFF,2);
DRAWTEXT(底金叉,DIFF-0.1,'低位金叉'),COLORRED;
DRAWTEXT(顶死叉,DIFF+0.1,'高位死叉'),COLORGREEN;

</CODE>
