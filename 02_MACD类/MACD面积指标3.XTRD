<CODE>
//MACD面积指标3
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
MACD:=2*(DIFF-DEA);
//每波面积（单根柱）
柱面积:=MACD;
正面积:=SUM(IF(MACD>0,MACD,0),BARSLAST(MACD<=0)+1);
负面积:=SUM(IF(MACD<0,MACD,0),BARSLAST(MACD>=0)+1);
本波面积:IF(MACD>0,正面积,负面积),COLORWHITE,LINETHICK2;
0,COLORGRAY,DOT;
DRAWTEXT(CROSS(MACD,0),0,'翻红'),COLORRED;
DRAWTEXT(CROSS(0,MACD),0,'翻绿'),COLORGREEN;

</CODE>
