<CODE>
//MACD综合指标1
DIFF:EMA(CLOSE,12)-EMA(CLOSE,26),COLORWHITE;
DEA:EMA(DIFF,9),COLORYELLOW;
MACD:2*(DIFF-DEA),COLORSTICK;
A1:=BARSLAST(REF(CROSS(DIFF,DEA),1));
底背离:=REF(CLOSE,A1+1)>CLOSE AND DIFF>REF(DIFF,A1+1) AND CROSS(DIFF,DEA);
DRAWLINE(A1=0,DEA,底背离,DEA,0),COLORRED,LINETHICK2;
DRAWTEXT(底背离,DEA-0.1,'底背离'),COLORRED;
A2:=BARSLAST(REF(CROSS(DEA,DIFF),1));
顶背离:=REF(CLOSE,A2+1)<CLOSE AND DIFF<REF(DIFF,A2+1) AND CROSS(DEA,DIFF);
DRAWLINE(A2=0,DEA,顶背离,DEA,0),COLORGREEN,LINETHICK2;
DRAWTEXT(顶背离,DEA+0.1,'顶背离'),COLORGREEN;
//金叉死叉
低位金叉:=CROSS(DIFF,DEA)&&DIFF<-0.1;
二次金叉:=COUNT(CROSS(DIFF,DEA),20)=2&&DIFF<0;
高位死叉:=CROSS(DEA,DIFF)&&DIFF>0.1;
二次死叉:=COUNT(CROSS(DEA,DIFF),20)=2&&DIFF>0;
DRAWICON(低位金叉,DIFF,1);
DRAWICON(二次金叉,DIFF,3);
DRAWICON(高位死叉,DIFF,2);
DRAWICON(二次死叉,DIFF,4);
DRAWTEXT(低位金叉,DIFF-0.15,'低位金叉'),COLORRED;
DRAWTEXT(二次金叉,DIFF-0.25,'二次金叉'),COLORMAGENTA;
DRAWTEXT(高位死叉,DIFF+0.15,'高位死叉'),COLORGREEN;
DRAWTEXT(二次死叉,DIFF+0.25,'二次死叉'),COLORCYAN;

</CODE>
<VERSION>
130112
</VERSION>
