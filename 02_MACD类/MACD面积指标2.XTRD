<CODE>
//MACD面积指标2
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
MACD:=2*(DIFF-DEA),COLORSTICK;
//红绿柱面积累加
红面积:=SUM(IF(MACD>0,MACD,0),0);
绿面积:=SUM(IF(MACD<0,MACD,0),0);
//面积比
面积比:红面积/ABS(绿面积+0.0001),COLORYELLOW,LINETHICK2;
基准:1,COLORGRAY,DOT;
//信号
DRAWTEXT(CROSS(面积比,1),0.5,'多头占优'),COLORRED;
DRAWTEXT(CROSS(1,面积比),1.5,'空头占优'),COLORGREEN;

</CODE>
