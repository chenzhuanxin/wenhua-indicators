<CODE>
//MACD背离指标
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
MACD:=2*(DIFF-DEA),COLORSTICK;
//顶背离：价格新高 而 DIFF 不新高
顶背离:=H=HHV(H,30)&&DIFF<REF(HHV(DIFF,30),1)&&COUNT(MACD>0,10)>3;
//底背离：价格新低 而 DIFF 不新低
底背离:=L=LLV(L,30)&&DIFF>REF(LLV(DIFF,30),1)&&COUNT(MACD<0,10)>3;
//画线
DRAWLINE(顶背离,H,1,MAX(CLOSE,OPEN),COLORGREEN);
DRAWLINE(底背离,L,1,MIN(CLOSE,OPEN),COLORRED);
DRAWTEXT(顶背离,H+0.05,'顶背离'),COLORGREEN,FONTSIZE16;
DRAWTEXT(底背离,L-0.05,'底背离'),COLORRED,FONTSIZE16;

</CODE>
