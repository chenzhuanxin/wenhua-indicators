<CODE>
//三指标共振（VOL/MACD/KDJ）
//--- MACD
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
MACD金叉:=CROSS(DIFF,DEA);
//--- KDJ
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
KDJ金叉:=CROSS(K,D);
//--- VOL
VOL金叉:=CROSS(MA(VOL,5),MA(VOL,10));
//三者同向
共振:MACD金叉&&KDJ金叉&&VOL金叉;
DRAWTEXT(共振,L,'三指标共振'),COLORRED,FONTSIZE20;
DRAWICON(共振,L,1);
//显示
DIFF:DIFF,COLORWHITE;
DEA:DEA,COLORYELLOW;
K:K,COLORMAGENTA;
D:D,COLORCYAN;

</CODE>
