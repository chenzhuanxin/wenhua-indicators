<CODE>
//三脉共振（VOL/MACD/KDJ）
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
MACD脉:=DIFF>DEA;
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
KDJ脉:=K>D;
VOL脉:=MA(VOL,5)>MA(VOL,10);
脉数:MACD脉+KDJ脉+VOL脉,COLORYELLOW,LINETHICK2;
0,COLORGRAY,DOT;
3,COLORGRAY,DOT;
DRAWTEXT(脉数=3,L,'三脉共振'),COLORRED,FONTSIZE20;

</CODE>
