<CODE>
//六指金叉共振
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
C1:=CROSS(DIFF,DEA);
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
C2:=CROSS(K,D);
LC:=REF(CLOSE,1);
RSI:=SMA(MAX(CLOSE-LC,0),14,1)/SMA(ABS(CLOSE-LC),14,1)*100;
C3:=CROSS(RSI,30);
LWR:=(HHV(HIGH,14)-CLOSE)/(HHV(HIGH,14)-LLV(LOW,14))*100;
C4:=CROSS(80,LWR);
BBI:=(MA(CLOSE,3)+MA(CLOSE,6)+MA(CLOSE,12)+MA(CLOSE,24))/4;
C5:=CROSS(CLOSE,BBI);
C6:=CROSS(MA(CLOSE,5),MA(CLOSE,10));
共振数:C1+C2+C3+C4+C5+C6,COLORWHITE,LINETHICK2;
0,COLORGRAY,DOT;
6,COLORGRAY,DOT;
DRAWTEXT(C1+C2+C3+C4+C5+C6>=4,L,'六指共振'),COLORRED,FONTSIZE20;

</CODE>
