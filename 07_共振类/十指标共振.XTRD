<CODE>
//十指标共振
//1 MACD
DIFF:=EMA(CLOSE,12)-EMA(CLOSE,26);
DEA:=EMA(DIFF,9);
C1:=CROSS(DIFF,DEA);
//2 KDJ
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
K:=SMA(RSV,3,1);
D:=SMA(K,3,1);
C2:=CROSS(K,D);
//3 RSI
LC:=REF(CLOSE,1);
RSI:=SMA(MAX(CLOSE-LC,0),14,1)/SMA(ABS(CLOSE-LC),14,1)*100;
C3:=CROSS(RSI,30);
//4 LWR
LWR:=(HHV(HIGH,14)-CLOSE)/(HHV(HIGH,14)-LLV(LOW,14))*100;
C4:=CROSS(80,LWR);
//5 BBI
BBI:=(MA(CLOSE,3)+MA(CLOSE,6)+MA(CLOSE,12)+MA(CLOSE,24))/4;
C5:=CROSS(CLOSE,BBI);
//6 MA
C6:=CROSS(MA(CLOSE,5),MA(CLOSE,10));
//7 VOL
C7:=CROSS(MA(VOL,5),MA(VOL,10));
//8 DMI
MTR:=SUM(MAX(MAX(HIGH-LOW,ABS(HIGH-REF(CLOSE,1))),ABS(LOW-REF(CLOSE,1))),14);
HD:=HIGH-REF(HIGH,1);
LD:=REF(LOW,1)-LOW;
PDI:=SUM(IF(HD>0&&HD>LD,HD,0),14)*100/MTR;
MDI:=SUM(IF(LD>0&&LD>HD,LD,0),14)*100/MTR;
C8:=CROSS(PDI,MDI);
//9 CCI
TYP:=(HIGH+LOW+CLOSE)/3;
CCI:=(TYP-MA(TYP,14))/(0.015*AVEDEV(TYP,14));
C9:=CROSS(CCI,-100);
//10 WR
WR1:=(HHV(HIGH,10)-CLOSE)/(HHV(HIGH,10)-LLV(LOW,10))*100;
C10:=CROSS(80,WR1);
共振数:C1+C2+C3+C4+C5+C6+C7+C8+C9+C10,COLORYELLOW,LINETHICK2;
0,COLORGRAY,DOT;
10,COLORGRAY,DOT;
DRAWTEXT(C1+C2+C3+C4+C5+C6+C7+C8+C9+C10>=6,L,'十指标共振'),COLORRED,FONTSIZE20;

</CODE>
