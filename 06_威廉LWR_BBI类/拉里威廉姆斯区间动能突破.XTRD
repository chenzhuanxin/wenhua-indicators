<CODE>
//拉里威廉姆斯区间动能突破
//Williams %R
WR1:=(HHV(HIGH,14)-CLOSE)/(HHV(HIGH,14)-LLV(LOW,14))*100;
//区间动能
TR1:=MAX(MAX(HIGH-LOW,ABS(HIGH-REF(CLOSE,1))),ABS(LOW-REF(CLOSE,1)));
ATR14:=MA(TR1,14);
//突破判定
上破:=CLOSE>REF(HHV(HIGH,14),1);
下破:=CLOSE<REF(LLV(LOW,14),1);
DRAWCOLORKLINE(上破,COLORRED,0);
DRAWCOLORKLINE(下破,COLORCYAN,0);
//动能强弱
动能:100-WR1,COLORYELLOW,LINETHICK2;
80,COLORGRAY,DOT;
20,COLORGRAY,DOT;
DRAWTEXT(上破&&动能>50,H+ATR14,'向上突破'),COLORRED,FONTSIZE18;
DRAWTEXT(下破&&动能<50,L-ATR14,'向下突破'),COLORGREEN,FONTSIZE18;

</CODE>
