<CODE>
//BBI 多空指标
BBI:(MA(CLOSE,3)+MA(CLOSE,6)+MA(CLOSE,12)+MA(CLOSE,24))/4,COLORYELLOW,LINETHICK2;
PARTLINE(CLOSE>BBI,BBI,COLORRED),LINETHICK2;
PARTLINE(CLOSE<BBI,BBI,COLORGREEN),LINETHICK2;
//信号
DRAWTEXT(CROSS(CLOSE,BBI),L,'上穿BBI'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(BBI,CLOSE),H,'下破BBI'),COLORGREEN,FONTSIZE18;

</CODE>
