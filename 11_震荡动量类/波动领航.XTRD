<CODE>
//波动领航
ATR1:=MAX(MAX(HIGH-LOW,ABS(HIGH-REF(CLOSE,1))),ABS(LOW-REF(CLOSE,1)));
ATR:=MA(ATR1,14);
//波动强度
波强:ATR/CLOSE*1000,COLORYELLOW,LINETHICK2;
强阈:=MA(波强,20);
//多色K线（按波动强弱用色）
DRAWCOLORKLINE(波强>强阈&&ISUP,COLORRED,0);
DRAWCOLORKLINE(波强>强阈&&ISDOWN,COLORCYAN,0);
DRAWCOLORKLINE(波强<=强阈&&ISUP,COLORMAGENTA,1);
DRAWCOLORKLINE(波强<=强阈&&ISDOWN,COLORGREEN,1);
强阈:强阈,COLORWHITE,DOT;

</CODE>
