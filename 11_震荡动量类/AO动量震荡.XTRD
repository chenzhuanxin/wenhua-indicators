<CODE>
//AO动量震荡（Bill Williams）
MEDIAN:=(HIGH+LOW)/2;
AO:MA(MEDIAN,5)-MA(MEDIAN,34),COLORSTICK;
0,COLORGRAY,DOT;
//颜色
DRAWCOLORKLINE(AO>0&&AO>REF(AO,1),COLORRED,0);
DRAWCOLORKLINE(AO>0&&AO<REF(AO,1),COLORMAGENTA,0);
DRAWCOLORKLINE(AO<0&&AO<REF(AO,1),COLORCYAN,0);
DRAWCOLORKLINE(AO<0&&AO>REF(AO,1),COLORGREEN,0);

</CODE>
