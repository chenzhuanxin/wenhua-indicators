<CODE>
//AC加速指标
MEDIAN:=(HIGH+LOW)/2;
AO:=MA(MEDIAN,5)-MA(MEDIAN,34);
AC:AO-MA(AO,5),COLORSTICK;
0,COLORGRAY,DOT;
DRAWCOLORKLINE(AC>0&&AC>REF(AC,1),COLORRED,0);
DRAWCOLORKLINE(AC>0&&AC<REF(AC,1),COLORMAGENTA,0);
DRAWCOLORKLINE(AC<0&&AC<REF(AC,1),COLORCYAN,0);
DRAWCOLORKLINE(AC<0&&AC>REF(AC,1),COLORGREEN,0);

</CODE>
