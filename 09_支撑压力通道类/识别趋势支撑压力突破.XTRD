<CODE>
//识别趋势支撑压力突破
N:=20;
压力:REF(HHV(HIGH,N),1),COLORRED,LINETHICK2;
支撑:REF(LLV(LOW,N),1),COLORGREEN,LINETHICK2;
趋:=MA(CLOSE,10);
PARTLINE(趋,CLOSE>趋,COLORRED),LINETHICK3;
PARTLINE(趋,CLOSE<趋,COLORGREEN),LINETHICK3;
DRAWTEXT(CROSS(CLOSE,压力),压力,'上破'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(支撑,CLOSE),支撑,'下破'),COLORGREEN,FONTSIZE18;

</CODE>
