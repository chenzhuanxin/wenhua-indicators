<CODE>
//唐奇安趋势改良版
N:=20;
M:=10;
上轨:REF(HHV(HIGH,N),1),COLORRED,LINETHICK2;
下轨:REF(LLV(LOW,N),1),COLORGREEN,LINETHICK2;
//改良：出场用短周期
出场多:REF(LLV(LOW,M),1),COLORMAGENTA,DOT;
出场空:REF(HHV(HIGH,M),1),COLORCYAN,DOT;
DRAWCOLORKLINE(CROSS(CLOSE,上轨),COLORRED,0);
DRAWCOLORKLINE(CROSS(下轨,CLOSE),COLORCYAN,0);
DRAWTEXT(CROSS(CLOSE,上轨),L,'唐奇安多'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(下轨,CLOSE),H,'唐奇安空'),COLORGREEN,FONTSIZE18;

</CODE>
