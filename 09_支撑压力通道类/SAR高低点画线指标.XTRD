<CODE>
//SAR高低点画线指标
SARLINE:=SAR(4,0.02,0.2),CIRCLEDOT,COLORYELLOW;
翻转:=CROSS(SARLINE,CLOSE);
翻转2:=CROSS(CLOSE,SARLINE);
高:=IF(翻转,HHV(HIGH,5),NULL);
低:=IF(翻转2,LLV(LOW,5),NULL);
DRAWLINE(翻转,HIGH,翻转2,CLOSE,COLORGREEN);
DRAWLINE(翻转2,LOW,翻转,CLOSE,COLORRED);
DRAWTEXT(翻转2,L,'SAR多'),COLORRED;
DRAWTEXT(翻转,H,'SAR空'),COLORGREEN;

</CODE>
