<CODE>
//LSS支撑阻力指标
K1:=REF(HHV(HIGH,20),1);
K2:=REF(LLV(LOW,20),1);
K3:=(K1+K2)/2;
DD:=(K1-K2)*0.382;
KK1:K1,COLORRED,LINETHICK2;
KK2:K2,COLORGREEN,LINETHICK2;
KK3:K3,COLORYELLOW,DOT;
上破:IF(CLOSE>K1,K1-DD*(CLOSE-K1)/((K1-K2)/2+0.0001),NULL),COLORMAGENTA;
下破:IF(CLOSE<K2,K2+DD*(K2-CLOSE)/((K1-K2)/2+0.0001),NULL),COLORCYAN;
DRAWTEXT(CROSS(CLOSE,K1),K1,'阻力突破'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(K2,CLOSE),K2,'支撑破位'),COLORGREEN,FONTSIZE18;

</CODE>
