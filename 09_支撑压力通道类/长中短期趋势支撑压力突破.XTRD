<CODE>
//长中短期趋势支撑压力突破
N1:=10;
N2:=30;
N3:=60;
短期压力:REF(HHV(HIGH,N1),1),COLORWHITE,DOT;
短期支撑:REF(LLV(LOW,N1),1),COLORWHITE,DOT;
中期压力:REF(HHV(HIGH,N2),1),COLORYELLOW,LINETHICK2;
中期支撑:REF(LLV(LOW,N2),1),COLORYELLOW,LINETHICK2;
长期压力:REF(HHV(HIGH,N3),1),COLORRED,LINETHICK3;
长期支撑:REF(LLV(LOW,N3),1),COLORGREEN,LINETHICK3;
DRAWTEXT(CROSS(CLOSE,长期压力),H,'长期突破'),COLORRED,FONTSIZE20;
DRAWTEXT(CROSS(长期支撑,CLOSE),L,'长期破位'),COLORGREEN,FONTSIZE20;

</CODE>
