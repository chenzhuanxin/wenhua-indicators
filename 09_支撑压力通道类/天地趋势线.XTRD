<CODE>
//天地趋势线
N:=60;
天:HHV(HIGH,N),COLORRED,LINETHICK2;
地:LLV(LOW,N),COLORGREEN,LINETHICK2;
中:(天+地)/2,COLORYELLOW,DOT;
DRAWTEXT(CROSS(CLOSE,天),H,'突破天'),COLORRED,FONTSIZE20;
DRAWTEXT(CROSS(地,CLOSE),L,'跌破地'),COLORGREEN,FONTSIZE20;
DRAWCOLORKLINE(CLOSE>天,COLORRED,1);
DRAWCOLORKLINE(CLOSE<地,COLORCYAN,1);

</CODE>
