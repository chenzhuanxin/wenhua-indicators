<CODE>
//自动画线指标（低点支撑）
N:=20;
低点:=LLV(L,N);
高点:=HHV(H,N);
//自动画支撑压力线
TRENDLINES(LOW,CLOSE);
支撑:低点,COLORGREEN,LINETHICK2;
压力:高点,COLORRED,LINETHICK2;
DRAWLINE(LOW=低点,LOW,1,LOW,COLORGREEN);
DRAWLINE(HIGH=高点,HIGH,1,HIGH,COLORRED);
DRAWTEXT(CROSS(CLOSE,压力),H,'破压力转支撑'),COLORRED;
DRAWTEXT(CROSS(支撑,CLOSE),L,'破支撑转压力'),COLORGREEN;

</CODE>
