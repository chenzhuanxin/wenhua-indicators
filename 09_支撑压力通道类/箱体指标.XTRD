<CODE>
//箱体指标
N:=20;
箱顶:REF(HHV(HIGH,N),1),COLORRED,LINETHICK2;
箱底:REF(LLV(LOW,N),1),COLORGREEN,LINETHICK2;
箱中:(箱顶+箱底)/2,COLORYELLOW,DOT;
//突破
DRAWTEXT(CROSS(CLOSE,箱顶),箱顶,'突破箱顶'),COLORRED,FONTSIZE18;
DRAWTEXT(CROSS(箱底,CLOSE),箱底,'跌破箱底'),COLORGREEN,FONTSIZE18;
DRAWCOLORKLINE(CROSS(CLOSE,箱顶),COLORRED,0);
DRAWCOLORKLINE(CROSS(箱底,CLOSE),COLORCYAN,0);

</CODE>
