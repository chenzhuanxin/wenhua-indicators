<CODE>
//通道线支撑压力
N:=20;
P:=2;
MID:=MA(CLOSE,N);
TR1:=MAX(MAX(HIGH-LOW,ABS(HIGH-REF(CLOSE,1))),ABS(LOW-REF(CLOSE,1)));
ATR:=MA(TR1,N);
上轨:MID+P*ATR,COLORRED,LINETHICK2;
下轨:MID-P*ATR,COLORGREEN,LINETHICK2;
中轨:MID,COLORYELLOW,DOT;
DRAWTEXT(CROSS(上轨,CLOSE),H,'触上轨'),COLORGREEN;
DRAWTEXT(CROSS(CLOSE,下轨),L,'触下轨'),COLORRED;

</CODE>
